# ---------------------------------------------------------------------------
# AgrozGO Monorepo Environment Configuration (v0.0.0)
# ---------------------------------------------------------------------------

NODE_ENV=development

# 1) Database (PostgreSQL)
DATABASE_URL=postgresql://agroz_user:agroz_secret_password@localhost:5432/agroz_b2b_dev?schema=public

# 2) Redis (Cache & Future Queues)
REDIS_URL=redis://localhost:6379

# 3) Backend Service (b2b/backend-b2b)
PORT=4000
API_PREFIX=v1
APP_URL=http://localhost:4000

# 4) Security & Authentication
JWT_ACCESS_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace_with_a_different_secure_random_secret_in_production
JWT_REFRESH_EXPIRES_IN=30d

# 5) Domains & Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://biznesgo.uz,https://admin.biznesgo.uz

# 6) Frontend URLs
FRONTEND_BIZNESGO_URL=https://biznesgo.uz
SUPER_ADMIN_URL=https://admin.biznesgo.uz

# 7) Telegram WebApp Security (initData verification)
# NOTE: Required for Telegram HMAC signature verification. Keep bot disconnected for v0.0.0.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=biznesgo_bot

