# Neon PostgreSQL connection string.
# Neon odatda sslmode=require bilan beradi:
# postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require
DATABASE_URL=

# Telegram BotFather token. Production Mini App uchun majburiy.
TELEGRAM_BOT_TOKEN=

# AI tashxis va ovozni matnga aylantirish uchun.
# Agar bo'sh bo'lsa, app offline demo tashxis bazasidan foydalanadi.
OPENAI_API_KEY=

# OpenAI-compatible endpoint. OpenAI uchun bo'sh qoldiring.
# Open-source model self-host qilinsa masalan:
# OPENAI_BASE_URL=https://your-vllm-server.example.com/v1
# AI_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
OPENAI_BASE_URL=
AI_MODEL=gpt-4o
ASR_MODEL=whisper-1

# Web saytingiz domeni, masalan: https://agro-ai.vercel.app
NEXT_PUBLIC_APP_URL=
