# ---------------------------------------------------------------------------
# AgroVet AI — muhit o'zgaruvchilari
# Nusxa oling: cp .env.example .env  (va qiymatlarni to'ldiring)
# ---------------------------------------------------------------------------

# 1) PostgreSQL / Neon ulanish satri (MAJBURIY)
# Neon odatda sslmode=require bilan beradi:
# postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require
DATABASE_URL=

# 2) Telegram BotFather tokeni.
# MAJBURIY: (a) initData imzosini tekshirish, (b) OTP kodni bot orqali yuborish uchun.
TELEGRAM_BOT_TOKEN=

# Bot username (ixtiyoriy — bo'sh bo'lsa getMe orqali avtomatik olinadi).
TELEGRAM_BOT_USERNAME=

# 2b) `@agroz_auth_bot` — mutaxassis/dorixona egalarini ro'yxatdan o'tkazuvchi bot.
# Asosiy botdan alohida token (BotFather'da shu bot uchun).
TELEGRAM_AUTH_BOT_TOKEN=

# Auth bot username (ixtiyoriy — asosiy botdagi "ro'yxatdan o'tish" tugmasi uchun).
# Bo'sh bo'lsa `agroz_auth_bot` ishlatiladi.
TELEGRAM_AUTH_BOT_USERNAME=agroz_auth_bot

# Auth bot webhook'i uchun alohida kalit (ixtiyoriy — bo'sh bo'lsa pastdagi umumiy kalit).
TELEGRAM_AUTH_WEBHOOK_SECRET=

# Webhook maxfiy kaliti (tavsiya etiladi): Telegram so'rovlari shu kalit bilan keladi.
# Tasodifiy uzun satr qo'ying: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# 3) AI tashxis va ovozni matnga aylantirish (OpenAI yoki OpenAI-compatible).
# Bo'sh bo'lsa ilova offline demo tashxis bazasidan foydalanadi.
OPENAI_API_KEY=
# OpenAI-compatible endpoint. OpenAI uchun bo'sh qoldiring.
# OPENAI_BASE_URL=https://your-vllm-server.example.com/v1
OPENAI_BASE_URL=
AI_MODEL=gpt-4o
ASR_MODEL=whisper-1

# 4) Sayt domeni (metadata/OG va kanonik havolalar uchun)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 5) SMS (OTP) — real kod yuborish uchun. To'ldirilmasa ilova "demo rejim"da
# ishlaydi va kod API javobida qaytadi (faqat development yoki OTP_DEV_MODE=true).
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Production'da SMS sozlanmagan bo'lsa ham kodni javobda qaytarish.
# FAQAT vaqtinchalik test uchun true qiling.
OTP_DEV_MODE=false

# 6) Demo ma'lumotlar. Standart: o'chirilgan — dorixonalar/mutaxassislar faqat
# ro'yxatdan o'tish orqali qo'shiladi. Faqat test uchun `true` qiling.
SEED_DEMO_DATA=false

# 7) Xavfsizlik / DB sozlamalari (ixtiyoriy)
# TELEGRAM_BOT_TOKEN yo'q bo'lganda ham imzosiz kirishga ruxsat (xavfli).
ALLOW_UNVERIFIED_TELEGRAM=false
# HTTPS bo'lmagan muhitda cookie yuborish uchun false qiling.
COOKIE_SECURE=
# Postgres SSL'ni majburiy yoqish (sslmode avtomatik aniqlanadi).
PGSSL=
# Pool'dagi maksimal ulanish soni (serverless uchun kichik turing).
PGPOOL_MAX=5
