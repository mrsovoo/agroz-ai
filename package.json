{
  "name": "agroz-ai",
  "private": true,
  "description": "AgrozGO (B2C) & BiznesGO (B2B) Ekotizimi",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node apps/api-backend/server.js",
    "build": "npm run build --workspace=apps/biznesgo-web && cp -r apps/biznesgo-web/dist ./dist",
    "dev:biznesgo": "npm run dev --workspace=apps/biznesgo-web",
    "dev:agrozgo": "npm run dev --workspace=apps/agrozgo-client",
    "dev:super-admin": "npm run dev --workspace=apps/super-admin",
    "dev:api": "npm run start:dev --workspace=apps/api-backend",
    "dev:bot": "npm run dev --workspace=apps/telegram-bot"
  }
}
