{
  "name": "agroz-ai",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "workspaces": [
    "frontend",
    "biznesgo",
    "admin",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "npx concurrently -n \"frontend,biznesgo,admin,backend\" -c \"blue,cyan,magenta,green\" \"npm run dev:frontend\" \"npm run dev:biznesgo\" \"npm run dev:admin\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:biznesgo": "npm run dev --workspace=biznesgo",
    "dev:biznesgo:full": "npx concurrently -n \"backend,biznesgo,bot-poll\" -c \"green,cyan,yellow\" \"npm run dev:backend\" \"npm run dev:biznesgo\" \"npm run telegram:poll\"",
    "dev:business": "npm run dev --workspace=biznesgo",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build:frontend && npm run build:biznesgo && npm run build:admin && npm run build:backend",
    "build:all": "npm run build:frontend && npm run build:biznesgo && npm run build:admin && npm run build:backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:biznesgo": "npm run build --workspace=biznesgo",
    "build:business": "npm run build --workspace=biznesgo",
    "build:admin": "npm run build --workspace=admin",
    "build:backend": "npm run build --workspace=backend",
    "vercel-build": "npm run build:frontend",
    "typecheck": "npm run typecheck:frontend && npm run typecheck:biznesgo && npm run typecheck:admin && npm run typecheck:backend",
    "typecheck:all": "npm run typecheck:frontend && npm run typecheck:biznesgo && npm run typecheck:admin && npm run typecheck:backend",
    "typecheck:frontend": "npm run typecheck --workspace=frontend",
    "typecheck:biznesgo": "npm run typecheck --workspace=biznesgo",
    "typecheck:business": "npm run typecheck --workspace=biznesgo",
    "typecheck:admin": "npm run typecheck --workspace=admin",
    "typecheck:backend": "npm run typecheck --workspace=backend",
    "lint": "npm run lint --workspace=frontend && npm run lint --workspace=admin && npm run lint --workspace=biznesgo",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:push": "npm run db:push --workspace=backend",
    "db:clear": "npm run db:clear --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "telegram:setup": "npm run telegram:setup --workspace=backend",
    "telegram:poll": "npm run telegram:poll --workspace=backend"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "cors": "^2.8.5",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.45.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "^9.1.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "tsx": "^4.19.3",
    "typescript": "5.9.3"
  }
}
