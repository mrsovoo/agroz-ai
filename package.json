{
  "name": "agrozgo-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "AgrozGO Central Asian Agricultural B2B & B2C Monorepo",
  "scripts": {
    "build": "pnpm --filter \"@agrozgo/*\" build",
    "lint": "pnpm --filter \"@agrozgo/*\" lint",
    "test": "pnpm --filter \"@agrozgo/*\" test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "dev:backend": "pnpm --filter @agrozgo/backend-b2b start:dev",
    "dev:biznesgo": "pnpm --filter @agrozgo/biznesgo dev",
    "dev:super-adm": "pnpm --filter @agrozgo/super-adm dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
