{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd agrozgo && npm install && npm run build",
  "outputDirectory": "agrozgo/dist",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/(.*)", "destination": "/app/index.html" },
    { "source": "/((?!app).*)", "destination": "/index.html" }
  ]
}

