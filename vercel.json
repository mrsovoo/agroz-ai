{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist_combined",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://backend-production-96bd5.up.railway.app/api/$1"
    },
    {
      "source": "/v1/(.*)",
      "destination": "https://backend-production-96bd5.up.railway.app/v1/$1"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
