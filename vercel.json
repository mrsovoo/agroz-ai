{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd agrozgo && npm install && npm run build",
  "outputDirectory": "agrozgo/dist",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://backend-production-96bd5.up.railway.app/api/$1" },
    { "source": "/app/(.*\\.[a-zA-Z0-9]+)", "destination": "/app/$1" },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/(.*)", "destination": "/app/index.html" },
    { "source": "/((?!app|api).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/app/(.*\\.wasm)",
      "headers": [{ "key": "Content-Type", "value": "application/wasm" }]
    }
  ]
}

