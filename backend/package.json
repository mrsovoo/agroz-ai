{
  "name": "agroz-ai-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:clear": "node scripts/db-clear.mjs",
    "db:seed": "node scripts/seed-data.mjs",
    "telegram:setup": "node scripts/telegram-setup.mjs",
    "telegram:poll": "node scripts/telegram-poll.mjs",
    "clean": "rm -rf node_modules dist && echo \"Backend cleaned\""
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "pg": "^8.20.0",
    "sharp": "^0.35.4",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  }
}
