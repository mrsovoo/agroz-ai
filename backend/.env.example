# ===========================================================================
# Agroz AI Backend — Muhit o'zgaruvchilari
# Nusxa oling: cp .env.example .env
# ===========================================================================

# Server porti va CORS ruxsatlari
PORT=4000
CORS_ORIGIN=http://localhost:3000

# 1) PostgreSQL / Neon ulanish satri (MAJBURIY)
# postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require
DATABASE_URL=

# 2) Admin panel (/api/admin/*)
ADMIN_USERNAME=admin
# DIQQAT: Production muhitda admin123 yoki 8 belgidan kam parol bilan server ishga tushmaydi!
ADMIN_PASSWORD=change_this_to_a_strong_password_min_8_chars

# 3) Telegram botlari (Fermerlar va Hamkorlar)
FARMER_BOT_TOKEN=
FARMER_BOT_USERNAME=agrozai_bot
FARMER_WEBHOOK_SECRET=

PARTNER_BOT_TOKEN=
PARTNER_BOT_USERNAME=agroz_auth_bot
PARTNER_WEBHOOK_SECRET=

WEB_APP_URL=https://agroz.uz
PARTNER_MINIAPP_URL=
APP_STORE_URL=
GOOGLE_PLAY_URL=

# Legacy / Zaxira nomlar (agar yuqoridagilar ko'rsatilmasa o'qiladi):
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=agrozai_bot
TELEGRAM_AUTH_BOT_TOKEN=
TELEGRAM_AUTH_BOT_USERNAME=agroz_auth_bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_AUTH_WEBHOOK_SECRET=

# 4) BiznesGO (@biznesgo_bot) — Agro-do'kon va sotuvchilar Mini App boti
BIZNESGO_BOT_TOKEN=
BIZNESGO_BOT_USERNAME=biznesgo_bot
BIZNESGO_MINI_APP_URL=https://biznesgo.uz
BIZNESGO_WEBHOOK_SECRET=
BACKEND_PUBLIC_URL=https://agroz-ai-backend-production.up.railway.app
ALLOW_PARTNER_DEMO=false
ALLOW_UNVERIFIED_TELEGRAM=false

# 5) AI tashxis va ovoz (Gemini yoki Groq)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.5-flash
ASR_MODEL=whisper-1

# 6) SMS (Eskiz.uz)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
OTP_DEV_MODE=false

# 7) Do'kon tekshiruvi uchun Demo akkaunt (App Store & Google Play Reviewers)
# Ushbu raqam va OTP kod berilsa, SMS yuborilmasdan do'kon tekshiruvchisi tizimga kira oladi
DEMO_PHONE=
DEMO_OTP=

# 8) Native Push bildirishnomalar (Firebase Cloud Messaging)
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key (.json)
# Ushbu JSON mazmuni (yoki uning base64 ko'rinishi) quyidagi o'zgaruvchiga qo'yiladi:
FIREBASE_SERVICE_ACCOUNT=

# 9) Boshlang'ich demo ma'lumotlar
SEED_DEMO_DATA=false

# 8) Ma'lumotlarni shifrlash uchun kalit (MAJBURIY - productionda)
# 64 hex karakter (32 byte) generatsiya qilish uchun: openssl rand -hex 32
ENCRYPTION_KEY=

# 9) Telefon raqamlarini hash qilish uchun alohida kalit (defense in depth)
# 64 hex karakter (32 byte) generatsiya qilish uchun: openssl rand -hex 32
HASH_KEY=

# 10) JWT imzo kaliti (MAJBURIY - productionda)
# 64 hex karakter (32 byte) generatsiya qilish uchun: openssl rand -hex 32
JWT_SECRET=

