# ===========================================================================
# Agroz AI Backend — Muhit o'zgaruvchilari
# Nusxa oling: cp .env.example .env
# ===========================================================================

# Server porti va CORS ruxsatlari
PORT=4000
CORS_ORIGIN=http://localhost:3000

# 1) PostgreSQL / Neon ulanish satri (MAJBURIY)
# postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require
DATABASE_URL=

# 2) Admin panel (/api/admin/*)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 3) Telegram bot tokenlari
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_AUTH_BOT_TOKEN=
TELEGRAM_AUTH_BOT_USERNAME=agroz_auth_bot

# 4) Webhook maxfiy kalitlari
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_AUTH_WEBHOOK_SECRET=

# 5) AI tashxis va ovoz (Gemini yoki Groq)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.8-flash
ASR_MODEL=whisper-1

# 6) SMS (Eskiz.uz)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
OTP_DEV_MODE=false

# 7) Boshlang'ich demo ma'lumotlar
SEED_DEMO_DATA=false

