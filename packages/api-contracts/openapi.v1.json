{
  "openapi": "3.0.3",
  "info": {
    "title": "AgrozGO B2B Core API",
    "version": "0.0.0",
    "description": "Enterprise-ready B2B API specification for AgrozGO agricultural commerce platform"
  },
  "servers": [
    {
      "url": "https://api.biznesgo.uz/v1",
      "description": "Production API Server"
    },
    {
      "url": "http://localhost:4000/v1",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Service Health Check",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is healthy and connected to database",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "version": { "type": "string", "example": "0.0.0" },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "database": { "type": "string", "example": "connected" }
                  },
                  "required": ["status", "version", "timestamp", "database"]
                }
              }
            }
          }
        }
      }
    }
  }
}

